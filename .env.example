# Production/server port. Local `npm run dev` uses 3004.
PORT=8098

# Optional host port for the ampcast container started by Docker Compose.
AMPCAST_PORT=8000

# Optional ampcast upstream URL for the same-origin /@player proxy.
# Defaults to the bundled Docker service at http://ampcast:8000/.
# Local npm development can use http://127.0.0.1:8000/.
# AMPCAST_URL=http://127.0.0.1:8000/

# Local SQLite database and shared music data root.
MUSIC_DATA_DIR=./data
DATABASE_URL=file:./data/app.sqlite

# LX_MUSIC_SOURCE_SCRIPT
# Use a private LX Music custom source URL with its key/apiKey query value.
LX_MUSIC_SOURCE_SCRIPT=https://example.com/lxmusic/source?key=<your-real-key>
# Enable only when the configured LX service provides a compatible /music/search endpoint.
# LX_MUSIC_ID_LOOKUP_ENABLED=false

# Optional instance secret used to encrypt QQ and player credentials.
# If omitted, XMusic creates MUSIC_DATA_DIR/.x-music-secret on first use.
# X_MUSIC_SECRET=<long-random-secret>

# Proactive QQ authorization renewal. The worker checks accounts hourly and
# refreshes sessions that are at least one day old or within seven days of
# access-token expiration. Failed accounts are retried at most every six hours.
QQ_AUTH_SWEEP_INTERVAL_MS=3600000
QQ_AUTH_AUTO_REFRESH_MAX_AGE_MS=86400000
QQ_AUTH_AUTO_REFRESH_WINDOW_MS=604800000
QQ_AUTH_AUTO_REFRESH_MIN_INTERVAL_MS=21600000
QQ_AUTH_EXPIRED_RECHECK_INTERVAL_MS=21600000

# Request logging to stdout for Docker/Dokploy logs. "auto" enables logs in
# production and keeps local `next dev` on Next's built-in request output.
# Use true to force-enable locally, false to reduce production log volume.
X_MUSIC_REQUEST_LOGS=auto

# Built-in tagging and file organization.
# When online metadata is enabled, XMusic fetches QQ Music detail, lyrics, and
# cover art, writes supported MP3/FLAC tags, and stores Emby-friendly sidecars
# beside the organized track in MUSIC_DATA_DIR/music.
TAGGING_WRITE_TAGS=true
TAGGING_FETCH_ONLINE_METADATA=true
TAGGING_ORGANIZE_FILES=true
TAGGING_FETCH_TIMEOUT_MS=5000

# Worker task retry settings.
WORKER_MAX_ATTEMPTS=3
# Wait for an in-flight playback cache before a background archive takes over.
ARCHIVE_ACTIVE_WAIT_MS=30000
ARCHIVE_ACTIVE_POLL_INTERVAL_MS=250

# Local audio cache cleanup. Staging/inbox are temporary download/decrypt areas;
# MUSIC_DATA_DIR/music is also cleaned after successful WebDAV sync. Set
# TRACK_CACHE_MAX_BYTES=0 to disable capacity-based pruning.
WORKER_CLEANUP_INTERVAL_MS=86400000
TRACK_CACHE_STAGING_TTL_HOURS=6
TRACK_CACHE_INBOX_TTL_DAYS=7
TRACK_CACHE_FAILED_TTL_DAYS=7
TRACK_CACHE_MAX_BYTES=21474836480

# Public UI label.
NEXT_PUBLIC_APP_NAME=XMusic

# Optional production-only analytics script tag.
# Use the complete script tag code provided by your analytics service.
# ANALYTICS_SCRIPT_CODE='<script src="https://example.com/analytics.js?id=<site-id>"></script>'
